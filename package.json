{
  "name": "node-pkware",
  "version": "5.9.2",
  "description": "node.js implementation of StormLib's pkware compressor/de-compressor",
  "main": "dist/stream/index.js",
  "types": "dist/stream/index.d.ts",
  "type": "module",
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=18.0.0"
  },
  "bin": {
    "explode": "dist/bin/explode.js",
    "implode": "dist/bin/implode.js"
  },
  "exports": {
    ".": {
      "default": "./dist/stream/index.js",
      "types": "./dist/stream/index.d.ts"
    },
    "./stream": {
      "default": "./dist/stream/index.js",
      "types": "./dist/stream/index.d.ts"
    },
    "./simple": {
      "default": "./dist/simple/index.js",
      "types": "./dist/simple/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.src.json && node scripts/rewrite-declaration-imports.ts",
    "build:watch": "nodemon --watch src --exec \"npm run build\" --ext ts",
    "lint": "rm -f xo.config.mjs && xo --ignore 'xo.config.mjs'",
    "lint:watch": "nodemon --watch src --exec \"npm run lint\" --ext ts",
    "prepublishOnly": "npm run lint && npm run typecheck && rm -rf dist && npm run build && find dist -type f -name \"*.spec.*\" -delete",
    "test": "node --test src/simple/*.spec.ts",
    "test:watch": "nodemon --watch src --exec \"npm run test\" --ext ts",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.scripts.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arx-tools/node-pkware.git"
  },
  "bugs": {
    "url": "https://github.com/arx-tools/node-pkware/issues"
  },
  "homepage": "https://github.com/arx-tools/node-pkware#readme",
  "author": "Lajos Meszaros <m_lajos@hotmail.com>",
  "contributors": [
    {
      "name": "DeepSeek Harness (AI coding agent) using DeepSeek-V41-Flash"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "minimist-lite": "^2.3.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.20.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nodemon": "^3.1.14",
    "pre-commit": "^2.0.0",
    "typescript": "^7.0.2",
    "xo": "^5.0.1"
  },
  "keywords": [
    "pkware",
    "stormlib",
    "implode",
    "explode",
    "compression",
    "decompression",
    "blast",
    "arx-fatalis"
  ],
  "pre-commit": {
    "run": [
      "lint",
      "typecheck",
      "test"
    ]
  }
}
